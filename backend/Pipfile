[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]
# FastAPI and Server - Allow minor and patch updates
fastapi = ">=0.104.1,<1.0.0"
uvicorn = {extras = ["standard"], version = ">=0.24.0,<1.0.0"}
python-multipart = ">=0.0.6"

# WebSocket support
websockets = ">=12.0,<13.0"

# Pydantic for data validation - Compatible releases
pydantic = "~=2.5"
pydantic-settings = "~=2.1"

# HTTP clients - Allow updates within major version
aiohttp = "~=3.9"
httpx = ">=0.25.2,<1.0.0"

# SPARQL - Stable version
SPARQLWrapper = "~=2.0"

# LLM clients - Allow minor updates for bug fixes
openai = ">=1.3.8,<2.0.0"
anthropic = ">=0.8.1,<1.0.0"

# Environment variables
python-dotenv = "~=1.0"

# Logging and monitoring
python-json-logger = "~=2.0"

[dev-packages]
# Testing
pytest = "~=7.4"
pytest-asyncio = "~=0.21"

# Code quality
black = "*"
flake8 = "*"
mypy = "*"

# Development tools
ipython = "*"

[requires]
python_version = "*"
python_full_version = "*"